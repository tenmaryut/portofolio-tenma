---
import { Image } from 'astro:assets';
import { profile } from '../../config/profile';
import { pageMeta, ogImagePath } from '../../data/pages';
import { routes, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import SectionLabel from '../SectionLabel.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const meta = pageMeta.about[locale];

const copy = {
  id: {
    label: 'Tentang',
    title: 'Kerja rapi untuk usaha kecil',
    photoAlt: `Foto ${profile.fullName ?? profile.displayName}`,
    background: [
      'Saya Tenma. Saya membuat website serta templat dan dashboard Excel/Google Sheets untuk usaha kecil. Saya juga menjalankan dua produk web buatan sendiri, TakarLaba dan PasalBaru.',
      'Saya terbiasa bekerja runtut: kebutuhan dicatat dengan jelas, data pengguna diperlakukan hati-hati, dan setiap kesepakatan dituangkan secara tertulis sebelum pekerjaan dimulai.',
      'Klaim di situs ini bisa Anda cek sendiri. Kedua produk saya online di domainnya masing-masing, situs demonya bisa dicoba, dan setiap studi kasus mencantumkan jumlah test serta skor Lighthouse.',
    ],
    aiNote:
      'Saya menulis kode bersama Claude Code, asisten coding AI, supaya pengerjaannya lebih cepat. Pekerjaan baru dianggap selesai setelah lulus test otomatis: Playwright untuk alur di browser, Vitest atau PHPUnit untuk logika, axe untuk aksesibilitas, dan Lighthouse untuk kecepatan. Hasil ujinya ikut diserahkan.',
    workflowLabel: 'Alur kerja',
    workflowTitle: 'Dari konsultasi sampai serah terima',
    workflowIntro: 'Setiap proyek mengikuti alur yang sama, supaya Anda selalu tahu apa yang sedang dikerjakan dan apa yang sudah disepakati.',
    steps: [
      {
        title: 'Konsultasi',
        body: 'Kita bahas tujuan website, kebutuhan, contoh referensi, tenggat, dan kisaran anggaran.',
      },
      {
        title: 'Penawaran dan perjanjian tertulis',
        body: 'Saya kirim penawaran berisi lingkup kerja, jadwal, dan biaya. Setelah disetujui, kita tanda tangani perjanjian yang mengatur termin pembayaran, batas revisi, serah terima, kerahasiaan, dan kepemilikan hak cipta kode.',
      },
      {
        title: 'Rancangan',
        body: 'Struktur halaman dan desain awal disepakati sebelum coding dimulai.',
      },
      {
        title: 'Pengembangan',
        body: 'Website dibangun bertahap bersama Claude Code, dan progresnya bisa Anda lihat di alamat uji coba.',
      },
      {
        title: 'Pengujian',
        body: 'Test otomatis, pemeriksaan tampilan di ponsel dan desktop, serta pengukuran kecepatan dan aksesibilitas dengan Lighthouse.',
      },
      {
        title: 'Serah terima',
        body: 'Website dipasang di hosting Anda, lalu kode, akses, dan panduan singkat diserahkan sesuai perjanjian.',
      },
      {
        title: 'Perawatan (opsional)',
        body: 'Pembaruan keamanan, pencadangan, dan perbaikan kecil sesuai kesepakatan.',
      },
    ],
    stackLabel: 'Stack',
    stackTitle: 'Teknologi yang saya pakai',
    stackIntro: 'Daftar ini hanya memuat teknologi yang sudah dipakai di produk dan proyek demo pada situs ini.',
    stackGroups: [
      { name: 'Antarmuka', items: ['HTML & CSS', 'TypeScript', 'Astro', 'React', 'Next.js', 'Tailwind CSS', 'PWA'] },
      { name: 'Backend & data', items: ['PHP', 'Laravel', 'Filament', 'Node.js', 'Hono', 'Python', 'SQLite', 'Drizzle ORM', 'Zod'] },
      { name: 'Pengujian & kualitas', items: ['Playwright', 'Vitest', 'PHPUnit', 'pytest', 'axe-core', 'Lighthouse'] },
      { name: 'Server & alat', items: ['Linux (Ubuntu)', 'Caddy', 'systemd', 'Git'] },
    ],
  },
  en: {
    label: 'About',
    title: 'Careful work for small businesses',
    photoAlt: `Photo of ${profile.fullName ?? profile.displayName}`,
    background: [
      'I’m Tenma. I build websites, plus Excel and Google Sheets templates and dashboards, for small businesses. I also run two web products of my own, TakarLaba and PasalBaru.',
      'I like to work in order: requirements are written down clearly, user data is handled with care, and every agreement is put in writing before work starts.',
      'You can check the claims on this site yourself. Both of my products are live on their own domains, the demo sites are open to try, and every case study lists its test counts and Lighthouse scores.',
    ],
    aiNote:
      'I write code with Claude Code, an AI coding assistant, so the work moves quickly. Work counts as done only after it passes automated tests: Playwright for browser flows, Vitest or PHPUnit for logic, axe for accessibility, and Lighthouse for speed. The test results are handed over with the work.',
    workflowLabel: 'Workflow',
    workflowTitle: 'From consultation to handover',
    workflowIntro: 'Every project follows the same steps, so you always know what is being worked on and what has been agreed.',
    steps: [
      {
        title: 'Consultation',
        body: 'We talk through the website’s goals, requirements, reference examples, deadline, and budget range.',
      },
      {
        title: 'Proposal and written agreement',
        body: 'I send a proposal covering scope, schedule, and cost. Once you approve it, we sign an agreement that sets out payment terms, revision limits, handover, confidentiality, and copyright ownership of the code.',
      },
      {
        title: 'Design',
        body: 'The page structure and initial design are agreed before any coding starts.',
      },
      {
        title: 'Development',
        body: 'The website is built in stages with Claude Code, and you can follow the progress on a staging address.',
      },
      {
        title: 'Testing',
        body: 'Automated tests, layout checks on phones and desktops, and speed and accessibility measurements with Lighthouse.',
      },
      {
        title: 'Handover',
        body: 'The website is deployed to your hosting, and the code, access, and a short guide are handed over as agreed.',
      },
      {
        title: 'Maintenance (optional)',
        body: 'Security updates, backups, and small fixes as agreed.',
      },
    ],
    stackLabel: 'Stack',
    stackTitle: 'The tools I use',
    stackIntro: 'This list includes only technologies already used in the products and demo projects on this site.',
    stackGroups: [
      { name: 'Front end', items: ['HTML & CSS', 'TypeScript', 'Astro', 'React', 'Next.js', 'Tailwind CSS', 'PWA'] },
      { name: 'Back end & data', items: ['PHP', 'Laravel', 'Filament', 'Node.js', 'Hono', 'Python', 'SQLite', 'Drizzle ORM', 'Zod'] },
      { name: 'Testing & quality', items: ['Playwright', 'Vitest', 'PHPUnit', 'pytest', 'axe-core', 'Lighthouse'] },
      { name: 'Servers & tooling', items: ['Linux (Ubuntu)', 'Caddy', 'systemd', 'Git'] },
    ],
  },
}[locale];
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={routes.about}
  ogImage={ogImagePath(locale, 'about')}
  current="about"
  pageType="ProfilePage"
>
  <div class="container-page py-12 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1fr_16rem] md:items-start lg:gap-16">
      <div>
        <SectionLabel number="04">{copy.label}</SectionLabel>
        <h1 class="mt-3 text-4xl sm:text-5xl">{copy.title}</h1>
        <div class="prose-page mt-6 text-lg text-muted">
          {copy.background.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="order-first md:order-none">
        {
          profile.photo ? (
            <Image
              src={profile.photo}
              alt={copy.photoAlt}
              widths={[256, 512]}
              sizes="256px"
              class="aspect-square w-40 rounded-2xl object-cover md:w-64"
              loading="eager"
            />
          ) : (
            <div
              class="legal-pad grid aspect-square w-40 place-items-center rounded-2xl border border-line md:w-64"
              aria-hidden="true"
            >
              <span class="font-display text-7xl font-semibold text-accent md:text-8xl">T</span>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <section class="border-y border-line bg-surface-2/60 py-16 md:py-20" aria-labelledby="alur-kerja">
    <div class="container-page">
      <div class="reveal">
        <SectionLabel number="4.1">{copy.workflowLabel}</SectionLabel>
        <h2 id="alur-kerja" class="mt-3 text-3xl sm:text-4xl">{copy.workflowTitle}</h2>
        <p class="mt-4 max-w-2xl text-muted">{copy.workflowIntro}</p>
        <p class="mt-6 max-w-[68ch] rounded-lg border border-line bg-surface p-4 text-[0.9375rem] text-muted">
          <Icon name="code" size={18} class="mr-2 inline-block align-[-0.2em] text-accent" />
          {copy.aiNote}
        </p>
      </div>
      <ol class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          copy.steps.map((step, index) => (
            <li class="reveal relative rounded-xl border border-line bg-surface p-5">
              <span class="font-mono text-sm text-accent" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 text-xl">{step.title}</h3>
              <p class="mt-2 text-[0.9375rem] text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-page py-16 md:py-20" aria-labelledby="stack">
    <div class="reveal">
      <SectionLabel number="4.2">{copy.stackLabel}</SectionLabel>
      <h2 id="stack" class="mt-3 text-3xl sm:text-4xl">{copy.stackTitle}</h2>
      <p class="mt-4 max-w-2xl text-muted">{copy.stackIntro}</p>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        copy.stackGroups.map((group) => (
          <div class="reveal rounded-xl border border-line bg-surface p-5">
            <h3 class="label-pasal">{group.name}</h3>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <a href={routes.contact[locale]} class="btn btn-primary mt-10">
      {t.cta.contact}
      <Icon name="arrow-right" size={18} />
    </a>
  </section>
</BaseLayout>
