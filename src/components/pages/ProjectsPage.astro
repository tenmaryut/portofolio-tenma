---
import { pageMeta, ogImagePath } from '../../data/pages';
import { projects } from '../../data/projects';
import { routes, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import ProjectCard from '../ProjectCard.astro';
import SectionLabel from '../SectionLabel.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const meta = pageMeta.projects[locale];

const copy = {
  id: {
    label: 'Proyek',
    title: 'Produk live dan proyek demo',
    intro: [
      'Empat proyek di bawah ini saya bangun mulai dari kebutuhan, desain, pengembangan, dan pengujian, sampai online dan bisa dicoba.',
      'TakarLaba dan PasalBaru adalah produk saya sendiri. Dua lainnya berupa demo untuk bisnis fiktif. Nama, produk, dan data di dalamnya bukan milik usaha nyata.',
    ],
    groups: {
      product: { title: 'Produk live', intro: 'Produk milik saya sendiri, online di domainnya masing-masing dan bisa dipakai siapa saja.' },
      demo: { title: 'Proyek demo', intro: 'Situs lengkap untuk bisnis fiktif, dengan kode sumber publik di GitHub.' },
    },
    ctaTitle: 'Butuh situs atau aplikasi web serupa?',
    ctaBody: 'Setiap proyek dimulai dengan konsultasi dan penawaran tertulis.',
  },
  en: {
    label: 'Projects',
    title: 'Live products and demo projects',
    intro: [
      'I built the four projects below from requirements, design, development, and testing all the way to a live site you can try.',
      'TakarLaba and PasalBaru are my own products. The other two are demos for fictional businesses, so the names, products, and data in them do not belong to any real business.',
    ],
    groups: {
      product: { title: 'Live products', intro: 'My own products, live on their own domains and open to anyone.' },
      demo: { title: 'Demo projects', intro: 'Complete sites for fictional businesses, with public source code on GitHub.' },
    },
    ctaTitle: 'Need a similar site or web app?',
    ctaBody: 'Every project starts with a consultation and a written proposal.',
  },
}[locale];

const groups = (['product', 'demo'] as const).map((kind) => ({
  kind,
  ...copy.groups[kind],
  projects: projects.filter((project) => project.kind === kind),
}));
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={routes.projects}
  ogImage={ogImagePath(locale, 'projects')}
  current="projects"
  pageType="CollectionPage"
>
  <div class="container-page py-12 md:py-20">
    <SectionLabel number="02">{copy.label}</SectionLabel>
    <h1 class="mt-3 text-4xl sm:text-5xl">{copy.title}</h1>
    <div class="prose-page mt-6 text-lg text-muted">
      {copy.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {
      groups.map((group, groupIndex) => (
        <section class="mt-12" aria-labelledby={`grup-${group.kind}`}>
          <h2 id={`grup-${group.kind}`} class="text-3xl">
            {group.title}
          </h2>
          <p class="mt-2 max-w-2xl text-muted">{group.intro}</p>
          <div class="mt-6 grid gap-6 md:grid-cols-2">
            {group.projects.map((project, index) => (
              <div class="reveal">
                <ProjectCard project={project} locale={locale} loading={groupIndex === 0 && index === 0 ? 'eager' : 'lazy'} />
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <div class="reveal mt-16 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-line bg-surface p-6">
      <div>
        <h2 class="text-2xl">{copy.ctaTitle}</h2>
        <p class="mt-1 text-muted">{copy.ctaBody}</p>
      </div>
      <a href={routes.contact[locale]} class="btn btn-primary">
        {t.cta.contact}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</BaseLayout>
