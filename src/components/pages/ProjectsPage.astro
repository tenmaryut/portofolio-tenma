---
import { pageMeta, ogImagePath } from '../../data/pages';
import { projects } from '../../data/projects';
import { routes, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import ProjectCard from '../ProjectCard.astro';
import SectionLabel from '../SectionLabel.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const meta = pageMeta.projects[locale];

const copy = {
  id: {
    label: 'Proyek',
    title: 'Proyek demo dan studi kasus',
    intro: [
      'Dua proyek di bawah ini saya bangun untuk menunjukkan cara saya bekerja: dari kebutuhan, desain, pengembangan, dan pengujian, sampai situsnya online dan bisa dicoba.',
      'Keduanya demo dengan bisnis fiktif. Nama, produk, dan data di dalamnya bukan milik usaha nyata, dan belum ada proyek klien yang ditampilkan di sini.',
    ],
    ctaTitle: 'Butuh situs serupa?',
    ctaBody: 'Setiap proyek dimulai dengan konsultasi dan penawaran tertulis.',
  },
  en: {
    label: 'Projects',
    title: 'Demo projects and case studies',
    intro: [
      'I built the two projects below to show how I work: from requirements, design, development, and testing, all the way to a live site you can try.',
      'Both are demos for fictional businesses. The names, products, and data in them do not belong to any real business, and no client work is shown here yet.',
    ],
    ctaTitle: 'Need a similar site?',
    ctaBody: 'Every project starts with a consultation and a written proposal.',
  },
}[locale];
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={routes.projects}
  ogImage={ogImagePath(locale, 'projects')}
  current="projects"
  pageType="CollectionPage"
>
  <div class="container-page py-12 md:py-20">
    <SectionLabel number="02">{copy.label}</SectionLabel>
    <h1 class="mt-3 text-4xl sm:text-5xl">{copy.title}</h1>
    <div class="prose-page mt-6 text-lg text-muted">
      {copy.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {projects.map((project, index) => (
        <div class="reveal">
          <ProjectCard project={project} locale={locale} headingLevel="h2" loading={index === 0 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>

    <div class="reveal mt-16 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-line bg-surface p-6">
      <div>
        <h2 class="text-2xl">{copy.ctaTitle}</h2>
        <p class="mt-1 text-muted">{copy.ctaBody}</p>
      </div>
      <a href={routes.contact[locale]} class="btn btn-primary">
        {t.cta.contact}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</BaseLayout>
