---
import { pageMeta, ogImagePath } from '../../data/pages';
import { routes, type Locale, type RouteKey } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const meta = pageMeta.notFound[locale];

const copy = {
  id: {
    label: 'Pasal 404',
    title: 'Halaman tidak ditemukan',
    body: 'Alamat yang Anda buka tidak ada atau sudah dipindahkan. Silakan kembali ke beranda atau buka salah satu halaman di bawah ini.',
  },
  en: {
    label: 'Article 404',
    title: 'Page not found',
    body: 'The address you opened does not exist or has moved. Head back to the home page or try one of the pages below.',
  },
}[locale];

const links: { key: RouteKey; label: string }[] = [
  { key: 'projects', label: t.nav.projects },
  { key: 'services', label: t.nav.services },
  { key: 'about', label: t.nav.about },
  { key: 'contact', label: t.nav.contact },
];
---

<BaseLayout locale={locale} title={meta.title} description={meta.description} ogImage={ogImagePath(locale, 'notFound')} noindex>
  <div class="container-page py-16 md:py-24">
    <div class="legal-pad max-w-3xl rounded-2xl border border-line py-10 pr-6 pl-14 md:py-14 md:pr-10 md:pl-[5.5rem]">
      <p class="label-pasal">{copy.label}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{copy.title}</h1>
      <p class="mt-5 max-w-[56ch] text-lg text-muted">{copy.body}</p>
      <a href={routes.home[locale]} class="btn btn-primary mt-8">
        <Icon name="arrow-left" size={18} class="icon-back" />
        {t.nav.home}
      </a>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
        {
          links.map((link) => (
            <li>
              <a href={routes[link.key][locale]} class="link-arrow min-h-11">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
